# Copy to .env next to this file and fill in. Never commit .env. It is copied to the server by deploy.sh.
DOMAIN=jd-to-cv.example.com
OWNER_NAME=Your Name
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=        # python -m web.auth hash
SECRET_KEY=                 # 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
PUBLIC_URL=https://jd-to-cv.example.com
# Optional: a host name for the read-only demo with made-up data. Add its DNS record (same server) first; empty keeps the demo unreachable.
DEMO_DOMAIN=
OPENROUTER_API_KEY=
CONTACT_EMAIL=contact@example.com
HOSTING_LABEL=Your hosting company, country
LINKEDIN_URL=https://www.linkedin.com/in/your-profile
GITHUB_URL=https://github.com/your-account
# Responsible person for the imprint and privacy pages. Address lines are separated by \n.
LEGAL_NAME=Your Name
LEGAL_ADDRESS=Street and number\nPostcode City\nCountry

# The public repository; the evals page links its documents when this is set (for example https://github.com/you/jd-to-cv).
REPO_URL=
# The read-only demo, linked from the menu (for example https://demo.example.com).
DEMO_URL=
