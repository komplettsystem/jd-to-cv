# Copy to .env and fill in. Never commit .env.
OWNER_NAME=Your Name
MATCH_CV=/path/to/cv.md
MATCH_PUBLIC_CV=/path/to/public-cv.md
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=        # python -m web.auth hash
SECRET_KEY=                 # 32+ random characters
COOKIE_SECURE=1
TRUST_PROXY=1
PUBLIC_URL=https://example.com
OPENROUTER_API_KEY=
AWS_REGION=eu-central-1
# An address made for this site (not a personal one), shown in the footer, on the roadmap and privacy pages.
CONTACT_EMAIL=contact@example.com
# Named on the privacy page and in the upload consent text.
HOSTING_LABEL=Your hosting company, country
LINKEDIN_URL=https://www.linkedin.com/in/your-profile
GITHUB_URL=https://github.com/your-account
# Responsible person for the imprint and privacy pages. Address lines are separated by \n.
LEGAL_NAME=Your Name
LEGAL_ADDRESS=Street and number\nPostcode City\nCountry
